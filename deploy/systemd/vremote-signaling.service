# VRemote signaling service (Node/WebSocket control plane — no media).
# Install as /etc/systemd/system/vremote-signaling.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now vremote-signaling
# The deploy workflow restarts this unit after each release symlink flip.
#
# Prerequisites:
#   - Node.js runtime on PATH (adjust ExecStart if node lives elsewhere)
#   - the release ships signaling/{dist,node_modules,package.json}
#   - runs as www-data (already present, unprivileged) — no dedicated user needed
#
# Config: the backend .env is the SINGLE SOURCE OF TRUTH. The signaling service reads it
# directly (Mongo connection + the shared VREMOTE_SESSION_SECRET / _SIGNALING_INTERNAL_SECRET)
# and resolves Laravel-style ${SERVICES} itself. shared/signaling.env is an OPTIONAL override
# for vars NOT present in the backend .env — ONLY PORT/INTERNAL_PORT. It may be absent.
# IMPORTANT: it is loaded FIRST so the backend .env is authoritative and always wins; never put
# MONGODB_* in signaling.env (a stale MONGODB_PORT there once shadowed the real 22688 and broke
# device auth). Ensure the backend .env is group-readable by www-data (chown vdeploy:www-data .env; chmod 640).

[Unit]
Description=VRemote signaling service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/vremote.vplus.vn/current/signaling
# Order matters: optional overrides FIRST, then the backend .env (single source of truth) LAST
# so its Mongo connection + shared secrets always win. Do NOT swap these lines.
EnvironmentFile=-/var/www/vremote.vplus.vn/shared/signaling.env
EnvironmentFile=/var/www/vremote.vplus.vn/shared/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3
# Bind only to loopback via env (PORT/INTERNAL_PORT); nginx fronts the public side.
# Hardening:
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
