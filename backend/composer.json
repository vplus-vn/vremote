{
  "name": "vplus-vn/vremote-backend",
  "description": "VRemote backend service",
  "type": "project",
  "repositories": [
    {"type": "vcs", "url": "https://github.com/vplus-platform/core-lib.git"}
  ],
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^7.1",
    "laravel/framework": "^13.8",
    "laravel/tinker": "^3.0",
    "mongodb/laravel-mongodb": "^5.8",
    "nwidart/laravel-modules": "^13.0",
    "paragonie/sodium_compat": "^2.5",
    "vplus-platform/core-lib": "dev-main"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5.12"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "php artisan test", "lint": "vendor/bin/pint --test"},
  "config": {"allow-plugins": {"wikimedia/composer-merge-plugin": true}, "platform": {"php": "8.3.33"}},
  "minimum-stability": "dev",
  "prefer-stable": true
}
