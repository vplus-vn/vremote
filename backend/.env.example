# ============================================================================
# VRemote backend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# In production this file lives at <deploy>/shared/.env and is symlinked into
# each release (see deploy/DEPLOY.md). Do not reuse any docker-compose demo value.
# ============================================================================

# ---- Application ----
APP_NAME=VRemote
# local | production
APP_ENV=production
# php artisan key:generate  (base64:...)
APP_KEY=
# false in production
APP_DEBUG=false
APP_URL=https://vremote.vplus.vn

# ---- Authentication ----
# Development bypass — MUST be false in production. Only honored in local/testing.
VREMOTE_DEV_AUTH=false
VREMOTE_DEV_ACTOR=local-admin

# VPlus platform integration — the SINGLE integration point (DSG-VREMOTE-002 §4).
# Base URL of the shared Platform service, WITH the /api/{service} prefix (house standard).
VREMOTE_PLATFORM_URL=https://cab.sab.com.vn/api/platform

# ---- Auth mode A (RECOMMENDED): introspection, like the S&B admin portal ----
# VRemote forwards the caller's bearer token to the Platform "who am I" endpoint and trusts
# its answer. Works with OPAQUE Platform tokens (no local JWT/public key needed). The console
# logs in through VRemote's own origin (POST /api/vremote/v1/auth/login proxies to the Platform).
VREMOTE_PLATFORM_INTROSPECT=true
# Paths appended to VREMOTE_PLATFORM_URL (adjust to the real Platform contract).
VREMOTE_PLATFORM_CHECKREF_PATH=/v1/auth/checkRef
VREMOTE_PLATFORM_ME_PATH=/v1/me
VREMOTE_PLATFORM_LOGIN_PATH=/v1/auth/login
# Seconds to cache an introspection result per token (reduces per-request Platform calls).
VREMOTE_INTROSPECT_TTL=30

# ---- Auth mode B (alternative): local RS256 JWT verify via vplus-platform/core-lib ----
# Only used when VREMOTE_PLATFORM_INTROSPECT is false. Needs the issuer public key (PEM inline
# or file path). iss/aud optional (empty = not checked).
CORE_JWT_PUBLIC_KEY=
CORE_JWT_PUBLIC_KEY_PATH=
CORE_JWT_ISSUER=
CORE_JWT_AUDIENCE=
# Further fallbacks when no CORE_JWT key is set: OIDC/JWKS discovery via VREMOTE_PLATFORM_URL,
# or a static issuer public key here.
VPLUS_USER_PUBLIC_KEY=
VPLUS_JWT_ALG=RS256

# ---- Database (MongoDB) ----
# Service name — DB, user and auth-db are derived from it (standard convention).
SERVICES=vremote
DB_CONNECTION=mongodb
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE="${SERVICES}"
MONGODB_USERNAME="${SERVICES}_user"
# Fill in the real DB password only in the server `.env` — never commit it.
MONGODB_PASSWORD=CHANGE_ME_DB_PASSWORD
MONGODB_AUTHENTICATION_DATABASE="${SERVICES}"

# ---- Session token (backend-issued web/viewer token) ----
# 32+ byte high-entropy random secret.
VREMOTE_SESSION_SECRET=
# Session TTL in seconds.
VREMOTE_SESSION_TTL=1800

# ---- Signaling ----
# Public WSS endpoint returned to the browser console.
VREMOTE_SIGNALING_URL=wss://vremote.vplus.vn/signaling
# Internal command-dispatch endpoint (loopback only, never public).
VREMOTE_SIGNALING_INTERNAL_URL=http://127.0.0.1:8788
# Shared secret guarding the internal /agent/send endpoint (must match signaling).
VREMOTE_SIGNALING_INTERNAL_SECRET=

# ---- Console / viewer ----
VREMOTE_VIEWER_URL=https://vremote.vplus.vn

# ---- STUN / TURN ----
VREMOTE_STUN_URL=stun:stun.l.google.com:19302
# Comma-separated TURN URLs, e.g. turn:turn.vplus.vn:3478,turns:turn.vplus.vn:5349
VREMOTE_TURN_URLS=
# coturn static-auth-secret; must match coturn and provisioned agents.
VREMOTE_TURN_SHARED_SECRET=

# ---- Fleet commands ----
# GATED operations (reboot/config-push/apk-update/cache-clear/remote.enable) stay OFF
# unless explicitly enabled by policy.
VREMOTE_GATED_COMMANDS=false

# ---- Device registry (transitional) ----
# Baseline v0.1.0 reads devices from this JSON; v0.2.0 moves the registry into MongoDB.
# Device tokens are secrets — keep them only here, never in Git.
VREMOTE_DEVICES_JSON={}
VREMOTE_TURN_URLS=turn:turn.vremote.example:3478
VREMOTE_TURN_SHARED_SECRET=change-me-turn-secret
# NOTE: quote the JSON so dotenv parses it (embedded spaces/braces otherwise break `.env`).
VREMOTE_DEVICES_JSON='{"DEV-001":{"machineCode":"DEMO-001","name":"Demo Android Box","platform":"android","status":"online","agentVersion":"0.2.0","deviceToken":"change-me-device-token"}}'
