# ============================================================================
# VRemote console (Vite/React) — build-time environment template.
# Copy to `.env` (or `.env.production`) before `npm run build`.
# These VITE_* values are compiled into the static bundle — never put secrets here.
# ============================================================================

# Download link for the signed Android agent APK (served by nginx at /downloads/).
VITE_AGENT_DOWNLOAD_URL=/downloads/vremote-agent.apk

# Local dev only: Vite dev-server proxy target for /api. Unused in the production
# build — in production the console is served at the domain root and calls the
# same-origin /api path handled by nginx.
VITE_API_PROXY_TARGET=http://localhost:8080
