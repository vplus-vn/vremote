# ============================================================================
# VRemote signaling service — OPTIONAL override template.
#
# The signaling service reads the backend `.env` directly (the SINGLE SOURCE OF
# TRUTH) for the Mongo connection, the shared VREMOTE_SESSION_SECRET /
# VREMOTE_SIGNALING_INTERNAL_SECRET, and the device registry. That file is loaded
# LAST by the systemd unit, so anything you also put here is IGNORED for those.
#
# Copy to `signaling.env` ONLY if you need to override a var that is NOT in the
# backend .env — in practice just the listener ports below. This file may be
# absent entirely.
#
# DO NOT put MONGODB_* here: a stale MONGODB_PORT in this file once shadowed the
# backend's real port and broke agent authentication. Keep Mongo config in the
# backend .env only.
# ============================================================================

# Public WebSocket port (nginx proxies /signaling and /agent here). Loopback-bound in prod.
PORT=8787
# Internal command-dispatch port for backend -> agent. NEVER expose publicly.
INTERNAL_PORT=8788
