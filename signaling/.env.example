# ============================================================================
# VRemote signaling service — environment template.
# Copy to `.env` and load it into the systemd unit (EnvironmentFile).
# Secrets MUST match the backend values. Never commit the real `.env`.
# ============================================================================

# Public WebSocket port (nginx proxies /signaling and /agent here). Loopback-bound in prod.
PORT=8787
# Internal command-dispatch port for backend -> agent. NEVER expose publicly.
INTERNAL_PORT=8788

# Must equal the backend VREMOTE_SESSION_SECRET (verifies viewer session tokens).
VREMOTE_SESSION_SECRET=
# Must equal the backend VREMOTE_SIGNALING_INTERNAL_SECRET (guards /agent/send).
VREMOTE_SIGNALING_INTERNAL_SECRET=

# Device -> deviceToken map used to authenticate agent WebSocket connections.
# Transitional (baseline v0.1.0). Enrolled / device-initiated-paired devices are looked up
# in MongoDB instead (below); keep this only for any static/demo devices.
# Device tokens are secrets — keep them only here, never in Git.
VREMOTE_DEVICES_JSON={}

# ---- MongoDB device-token source (enables enrolled + paired devices to connect) ----
# Same DB as the backend. When unset, only VREMOTE_DEVICES_JSON is used.
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=vremote
MONGODB_USERNAME=vremote_user
MONGODB_PASSWORD=
MONGODB_AUTHENTICATION_DATABASE=vremote
